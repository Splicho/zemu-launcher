# Environment variables for ZEmu Launcher
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit secrets to it.
#
# Frontend / Vite (VITE_ prefix — bundled into the renderer, PUBLIC):
VITE_API_BASE_URL=http://localhost:3003
VITE_API_URL=http://localhost:3002
VITE_LAUNCHER_REALTIME_URL=ws://localhost:3007

# Backend / Rust (no prefix — never bundled into the renderer, PRIVATE):
#
#   ZEMU_SESSION_ID_ENDPOINT
#     URL of the keys service that issues session ids.
#     Default: the built-in production endpoint.
#
#   ZEMU_SESSION_ID_BEARER_TOKEN
#     Bearer token for authenticating against the keys service.
#     REQUIRED — must be set before building for production.
#
#   ZEMU_GAME_SERVER
#     Game server hostname:port passed to the game at launch.
#     Default: eu.zemu.uk:1115
