{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "autostart:default",
    "opener:default",
    "opener:allow-open-url",
    "fs:default",
    "fs:allow-write-file",
    {
      "identifier": "fs:allow-write",
      "allow": ["$APPCONFIG/*", "$APPDATA/*"]
    }
  ]
}
