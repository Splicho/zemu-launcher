{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZEmu Launcher",
  "version": "0.1.52",
  "identifier": "uk.zemu.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:vite",
    "beforeBuildCommand": "pnpm build:vite"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ZEmu Launcher",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "decorations": true,
        "shadow": true,
        "center": true
      },
      {
        "label": "bootstrap",
        "create": false,
        "title": "ZEmu Launcher",
        "width": 460,
        "height": 430,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://*.zemu.uk wss://socket.zemu.uk https://api.github.com; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../assets/icon/app-icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNDcxRTAzNkU5MjFBRDIKUldUU0dwSnVBeDVIMGhjNVQ2QVBsdTNsNDNpNGc4MGNTL0hyeHRkSU4vZUJXZG85bmJqU29TVXYK",
      "endpoints": [
        "https://github.com/Splicho/zemu-launcher-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "zemu-launcher"
        ]
      }
    }
  }
}
